<?xml version="1.0" encoding="UTF-8"?>
<!-- Samsung Tizen TV app (docs/tv/samsung.md): a local page that finds the
     server and shows its app in a frame (docs/adr/008-tv-apps.md). -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://mediaserver.local/tv" version="1.0.0" viewmodes="maximized">
	<tizen:application id="MdSrvTV001.mediaserver" package="MdSrvTV001" required_version="6.0"/>
	<tizen:profile name="tv-samsung"/>
	<name>mediaserver</name>
	<icon src="icon.png"/>
	<content src="index.html"/>
	<feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
	<!-- The server is on the local network, at an address chosen at run time. -->
	<access origin="*" subdomains="true"/>
	<tizen:allow-navigation>*</tizen:allow-navigation>
	<!-- The page is a single file with inline script and style (web/vite.tv.config.ts). -->
	<tizen:content-security-policy>default-src * data: blob: 'unsafe-inline' 'unsafe-eval'</tizen:content-security-policy>
	<tizen:privilege name="http://tizen.org/privilege/internet"/>
	<tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
	<tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
