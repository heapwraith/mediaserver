{
	"name": "mediaserver-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:tv": "vite build --config vite.tv.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --type-aware --deny-warnings",
		"typecheck": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --fail-on-warnings",
		"check": "npm run fmt:check && npm run typecheck && npm run lint",
		"test": "vitest run",
		"check:build": "vite build && vite build --config vite.tv.config.ts && node scripts/check-build.ts build build-tv"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"hls.js": "1.7.4",
		"jassub": "2.5.23",
		"lrud": "8.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@unocss/preset-legacy-compat": "66.12.0",
		"browserslist": "4.29.5",
		"lightningcss": "1.33.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"unocss": "66.12.0",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=24"
	}
}
